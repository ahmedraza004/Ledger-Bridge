{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "apps/api/src/**/*",
    "apps/api/test/**/*",
    "apps/web/src/**/*"
  ],
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}
